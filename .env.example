# ==============================================================================
# LOGISTICPRO - BACKEND ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copiez ce fichier sous le nom .env et configurez vos propres valeurs :
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVEUR
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Domaines autorisés pour le CORS (séparés par des virgules)
# En local : http://localhost:5173
# En production : https://mon-app.vercel.app,https://admin.logisticpro.com
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. BASE DE DONNÉES (MySQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_transport
DB_DIALECT=mysql

# Optionnel : URL complète de connexion (supportée par Render / Railway / Aiven)
# DATABASE_URL=mysql://root:password@localhost:3306/project_transport

# Activer SSL pour les bases distantes (ex: Aiven, PlanetScale, AWS RDS)
# DB_SSL=true

# ------------------------------------------------------------------------------
# 3. SÉCURITÉ & AUTHENTIFICATION (JWT)
# ------------------------------------------------------------------------------
# Clé secrète pour la signature des JWT (générez-en une forte avec 'npm run generate_secret:prod')
JWT_SECRET=votre_cle_secrete_tres_longue_et_aleatoire_ici

# ------------------------------------------------------------------------------
# 4. CONFIGURATION SMTP (Emails)
# ------------------------------------------------------------------------------
# Pour le développement local (MailDev) :
EMAIL_HOST=127.0.0.1
EMAIL_PORT=1025
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="LogisticPro <no-reply@logisticpro.com>"

# Pour la production (ex: Gmail, Brevo, SendGrid, Resend, Mailgun) :
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=votre_api_key_sendgrid
# EMAIL_FROM="LogisticPro <no-reply@logisticpro.com>"
